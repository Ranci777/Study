import numpy as np
  
 def gauss_seidel(A, b, x0, tol, max_iter):
    n = len(b)
    x = x0.copy()
    for k in range(max_iter):
         x_old = x.copy()
         for i in range(n):
            # Nota: x[:i] usa os valores já atualizados nesta iteração k
           sum_ax_new = np.dot(A[i, :i], x[:i]) 
           # Nota: x_old[i+1:] usa os valores da iteração anterior k-1
             sum_ax_old = np.dot(A[i, i+1:], x_old[i+1:])
             x[i] = (b[i] - sum_ax_new - sum_ax_old) / A[i, i]
       
        if np.linalg.norm(x - x_old, ord=np.inf) < tol:
           print(f"Convergiu em {k+1} iterações.")
             return x
            
     print("Não convergiu no número máximo de iterações.")
    return x
  
 # Exemplo de uso:
 A = np.array([[10.0, 2.0, 1.0], [1.0, 5.0, 1.0],[2.0, 3.0, 10]])
 b = np.array([7.0,-8.0, 6.0])
 x0 = np.array([0.0, 0.0,0.0]) # Mesma condição inicial
 
 tol=1e-5 
 max_iter=3
  
 solucao_seidel = gauss_seidel(A, b, x0, tol, max_iter)
 print("Solução (Seidel):", solucao_seidel)
  
