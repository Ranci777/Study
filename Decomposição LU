import numpy as np
   
 # Matriz A e vetor b
  A = np.array([[2, 1, 1],
                [4, 3, 3],
               [6, 5, 4]], dtype=float)
   
 b = np.array([5, 11, 17], dtype=float)
   
 # Inicializa L como identidade e U como zeros
 
 # Decomposição LU (sem pivoteamento)
def decomposicaoLU(A,b):
  n = len(A)
  L = np.eye(n)
  U = np.zeros((n, n))
 for i in range(n):
      for j in range(i, n):
          total = 0.0
         for k in range(i):
             total += L[i][k] * U[k][j]
          U[i][j] = A[i][j] - total
       for j in range(i+1, n):
           total = 0.0
          for k in range(i):
              total += L[j][k] * U[k][i]
          L[j][i] = (A[j][i] - total) / U[i][i]
  
   # Resolver L·y = b (substituição direta)
   y = np.zeros(n)
   for i in range(n):
       total = 0.0
     for j in range(i):
         total += L[i][j] * y[j]
       y[i] = b[i] - total
 
# Resolver U·x = y (substituição retroativa)
  x = np.zeros(n)
  for i in range(n-1, -1, -1):
       total = 0.0
     for j in range(i+1, n):
         total += U[i][j] * x[j]
      x[i] = (y[i] - total) / U[i][i]
   return x
 # Resultado
 x = decomposicaoLU(A,b)
 print("Solução do sistema A·x = b:")
 print(x)
  
